# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Neon: pooled connection for the running API (host contains "-pooler").
# Use sslmode=verify-full (node-postgres treats "require" as verify-full anyway and warns).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Neon: direct connection (same host without "-pooler") — used only by Prisma Migrate / seed / create-admin.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full
# node-postgres pool size per API process (Neon pooler handles fan-in).
DATABASE_POOL_MAX=10

# Exact origin of the Next.js frontend (several: comma-separated); POST/PATCH/DELETE from any other origin get 403.
# Both dev ports: `next dev` uses 3001 when another app already holds 3000. In production, only the site's origin.
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001
# At least 32 random characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Express "trust proxy": "loopback" when Next.js runs on the same host, or the hop count ("1") behind a load balancer.
TRUST_PROXY=loopback

# Lead attachments (Cloudinary). All three are required for file uploads; without them leads still work and uploads
# are refused with a clear message. Server-side only: never expose the secret to the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder (public_id prefix) for this environment's files; use a different one per environment. Default: mcl-crm.
CLOUDINARY_FOLDER=mcl-crm

# Country (ISO code) for phone numbers sent without "+code" — older API callers and legacy rows. The app itself sends
# E.164 ("+91…"). Keep equal to the frontend's NEXT_PUBLIC_DEFAULT_PHONE_COUNTRY. Default: IN.
DEFAULT_PHONE_COUNTRY=IN

# Forgot-password OTP emails (any SMTP provider). Leave blank and codes are NOT sent (the API logs a warning).
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
EMAIL_FROM="MCL CRM <no-reply@example.com>"

# Tests only: a dedicated Neon test branch. EVERY TABLE IS WIPED on each `npm test` run.
TEST_DATABASE_URL=
