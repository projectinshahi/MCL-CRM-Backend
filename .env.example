# MCL CRM API configuration. Copy to .env for local development (git ignores .env). On a host, set the same names in
# its environment / secret settings instead of uploading a file. The API checks everything at startup and stops,
# naming each problem (never a value), when something required is missing or invalid.
# No real credentials in this file: it is committed.

# ---------- Required ----------

# Neon POOLED connection string (host contains "-pooler") — the running API uses it. Secret.
# Use sslmode=verify-full (node-postgres treats "require" as verify-full anyway and warns).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Neon DIRECT connection string (same host without "-pooler"). Not used by the running API: Prisma Migrate
# (`npm run db:deploy`), the seed and create-admin need it, because migrations take a lock PgBouncer can't hold.
# DATABASE_UNPOOLED_URL (Neon's own name for it) is accepted instead. Secret.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Exact origin(s) of the frontend, comma-separated; POST/PATCH/DELETE from any other origin get 403.
# Development: both dev ports (`next dev` uses 3001 when 3000 is taken). Production: only the site's https origin,
# e.g. https://crm.example.com — production refuses a plain-http origin other than localhost.
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001

# At least 32 random characters, different per environment. Secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---------- Optional (defaults shown) ----------

# development | production | test. Leave unset: `npm run dev` runs as development, the built API (`npm start`)
# as production (Secure cookies, production checks). Set it only to override that.
# NODE_ENV=
# Port to listen on; most hosts set PORT themselves.
# PORT=4000
# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info
# Database connections each API process keeps open (Neon's pooler handles the fan-in).
# DATABASE_POOL_MAX=10

# Which proxies may report the client's address (per-address rate limits, logs). Default false: the Next.js rewrite
# passes on whatever X-Forwarded-For the browser sent, so trusting it lets anyone pick their own address. Set a hop
# count (e.g. 1) or an address list only for a proxy you run in front of the API that overwrites that header.
# TRUST_PROXY=false

# Forgot-password codes by email: any SMTP provider. Set both or neither. Without them, Forgot password answers
# "isn't set up yet" and an administrator sets new passwords in Users. SMTP_URL is a secret.
#   SMTP_URL=smtps://USER:PASSWORD@smtp.your-provider.com:465
#   EMAIL_FROM="MCL CRM <no-reply@your-domain.com>"
SMTP_URL=
EMAIL_FROM=

# Lead and customer files (Cloudinary, private assets): all three or none. Without them everything else works and
# uploads are refused with a clear message. Server-side only; CLOUDINARY_API_SECRET is a secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder (public_id prefix) for this environment's files: a different one per environment, e.g. mcl-crm-dev.
# CLOUDINARY_FOLDER=mcl-crm

# Country (ISO code) for phone numbers sent without "+code" (older API callers, legacy rows). The app sends E.164.
# Keep equal to the frontend's NEXT_PUBLIC_DEFAULT_PHONE_COUNTRY.
# DEFAULT_PHONE_COUNTRY=IN

# ---------- Not for the API ----------
# Tests: TEST_DATABASE_URL (and optionally TEST_DIRECT_URL) go in .env.test — that database is WIPED by every run.
# First administrator: ADMIN_NAME, ADMIN_EMAIL, ADMIN_PASSWORD are given on the command line to `npm run create-admin`
# once, never stored here.
